# --- Privy (create an app at https://dashboard.privy.io) ---
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# --- Solana RPC (use a free-tier paid provider in production to avoid rate limits) ---
NEXT_PUBLIC_SOLANA_NETWORK_PROFILE=devnet
# Both client endpoints are visible in the browser. In production use a
# mainnet provider key restricted by allowed domain, rate limit, and quota.
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-restricted-mainnet-rpc.example
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://your-restricted-mainnet-rpc.example

# Safety gate. Keep false until the explicit mainnet micro-test review.
NEXT_PUBLIC_ENABLE_MAINNET_TRANSACTIONS=false
NEXT_PUBLIC_ENABLE_DEVNET_TRANSACTIONS=false

# Devnet endpoints are completely separate from Mainnet. Keep both transaction
# flags false until the explicit Devnet micro-test checklist is approved.
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://your-restricted-devnet-rpc.example
NEXT_PUBLIC_SOLANA_DEVNET_RPC_SUBSCRIPTIONS_URL=wss://your-restricted-devnet-rpc.example
SOLANA_DEVNET_RPC_URL=https://your-server-only-devnet-rpc.example

# Server-only RPC used to verify deposits. It may be the same provider, but
# never expose a privileged/server API key through a NEXT_PUBLIC_ variable.
RPC_URL=https://your-server-only-mainnet-rpc.example

# Canonical mainnet USDC. Override only for a test environment where the
# configured Jupiter Earn market actually supports the replacement mint.
# Mints/programs are fixed by the selected profile and are intentionally not
# environment-overridable: Mainnet canonical USDC or Circle Devnet USDC.

# --- Solana Explorer cluster used for transaction links ('devnet' | 'testnet' | 'mainnet-beta') ---
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet

# --- Persistent backend state (Supabase, Neon, or any PostgreSQL service) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Pin the Jupiter Lending program accepted by on-chain verification.
JUPITER_LENDING_PROGRAM_ID=jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9
